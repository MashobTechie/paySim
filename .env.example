# Copy to .env and adjust. Placeholder values only — never commit real credentials.

NODE_ENV=development

# PostgreSQL (docker-compose). Host port 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_USER=paysim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paysim
POSTGRES_PORT=5433
DATABASE_URL=postgresql://paysim:change-me@localhost:5433/paysim?schema=public

# API
API_PORT=4000
LOG_LEVEL=log
CORS_ORIGIN=http://localhost:3000

# Web (server-side only — the dashboard probes the API from the Next.js server)
PAYSIM_API_URL=http://localhost:4000
